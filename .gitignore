# Secrets -- never commit PATs, tokens, or credentials
.env
.env.*
!.env.example

# Personal interview/resume prep -- needed locally, never tracked, same
# pattern as .env.local. A pre-written answer key undermines the thing
# it's meant to demonstrate if an interviewer finds it in the repo.
private/

__pycache__/
*.pyc

# Local Claude Code tooling config (installed skills/agents) -- not a project
# deliverable. .claude/skills/tufte/ in particular is its own nested git
# checkout; committing it would vendor another project's history into this
# repo instead of just referencing it. The real record of which skills were
# used is CLAUDE.md and the docs/stage*-notes.md files, not this directory.
.claude/
.agents/

# Same category: the agency-agents installer's Cursor role files -- local
# tooling config, not a project deliverable. Tracked since the first commit
# by inconsistency (before the .claude/.agents/ exclusion reasoning above
# existed); untracked for consistency once noticed.
.cursor/
